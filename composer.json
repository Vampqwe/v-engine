{
    "name": "v-engine/core",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-redis": "Required when CACHE_DRIVER, SESSION_DRIVER, RATE_LIMIT_DRIVER, or QUEUE_DRIVER is set to redis."
    },
    "autoload": {
        "psr-4": {
            "VEngine\\": "src/",
            "App\\": "app/",
            "Sites\\": "sites/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff --no-interaction",
        "cs:fix": "php-cs-fixer fix --no-interaction",
        "test": "phpunit",
        "console": "php bin/console.php",
        "admin:create": "php bin/console.php admin:create",
        "cache:clear": "php bin/console.php cache:clear",
        "rate-limit:gc": "php bin/console.php rate-limit:gc",
        "queue:work": "php bin/console.php queue:work"
    }
}