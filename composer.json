{
    "name": "v-engine/core",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "VEngine\\": "src/",
            "App\\": "app/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff --no-interaction",
        "cs:fix": "php-cs-fixer fix --no-interaction",
        "test": "phpunit",
        "admin:create": "php bin/create-admin.php",
        "cache:clear": "php bin/cache-clear.php"
    }
}