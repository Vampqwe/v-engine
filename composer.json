{
    "name": "v-engine/core",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "VEngine\\": "src/",
            "App\\": "app/",
			"Modules\\": "modules/"
        }
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
		"admin:create": "php bin/create-admin.php",
		"cache:clear": "php bin/cache-clear.php"
    }
}