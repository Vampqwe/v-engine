# ==============================================================================
# Конфигурация окружения V-engine
# Скопируйте этот файл в .env перед запуском приложения: cp .env.example .env
# ==============================================================================

# Режим работы приложения:
# dev  - режим разработки (подробный вывод ошибок со стеком вызовов и фрагментом кода)
# prod - продакшен-режим (скрытие технических деталей ошибок от пользователей)
APP_ENV=dev
# Подробная страница ошибки включена только в dev и только при APP_DEBUG=true.
# Не включайте debug для публичного production-сайта.
APP_NAME=V-engine
APP_SITE=Corporate
# Сгенерируйте случайный токен длиной не менее 32 символов для защищённых API-маршрутов.
API_TOKEN=

# ------------------------------------------------------------------------------
# Настройки подключения к базе данных MySQL (используются в модуле DataBase)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=v_engine
DB_USER=root
# Укажите пароль своей локальной БД, если он задан.
DB_PASS=

# Redis необязателен. Для Redis cache/session/rate limiter/queue установите ext-redis
# и явно переключите соответствующий драйвер на redis.
CACHE_DRIVER=file
CACHE_REDIS_FALLBACK=true
SESSION_DRIVER=file
RATE_LIMIT_DRIVER=file
QUEUE_DRIVER=file
QUEUE_VISIBILITY_TIMEOUT=300
# Список разрешённых классов заданий через запятую для worker JSON payload.
QUEUE_JOBS=
# Максимальный размер тела HTTP-запроса, байты.
HTTP_MAX_BODY_BYTES=1048576

# Настройки подключения к Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=vengine:
REDIS_CONNECT_TIMEOUT=1
REDIS_TIMEOUT=0.5
DB_CONNECT_TIMEOUT=2

# Точные IP/CIDR доверенных reverse proxy через запятую, например 10.0.0.5,10.0.1.0/24.
# Не добавляйте подсеть, если не контролируете каждый адрес в ней; пустое значение безопасно без proxy.
TRUSTED_PROXIES=
